    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "__DS_PROMETHEUS__"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__DS_PROMETHEUS__"
     },
     "expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=\"$project\", service_name=\"$service\", deployment_environment_name=\"$env\"}[5m]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Erro 5xx (%)",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "__DS_PROMETHEUS__"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__DS_PROMETHEUS__"
     },
     "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_namespace=\"$project\", service_name=\"$service\", deployment_environment_name=\"$env\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_namespace=\"$project\", service_name=\"$service\", deployment_environment_name=\"$env\"}[5m])),0.001)"
    }
   ]
